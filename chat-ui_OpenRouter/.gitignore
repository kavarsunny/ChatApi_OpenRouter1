# ─────────────────────────────────────────────────────────────────
/dist/
/tmp/
/out-tsc/
/bazel-out/
/.angular/cache/
.sass-cache/
/coverage/
/libpeerconnection.log
testem.log
/typings/
/connect.lock/

# ─────────────────────────────────────────────────────────────────
# IDEs & editors
# ─────────────────────────────────────────────────────────────────

## Visual Studio Code (keep shared settings, ignore personal overrides)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/

## JetBrains (WebStorm / Rider)
.idea/
*.iml

## Sublime Text
*.sublime-workspace
*.sublime-project

## Eclipse
.project
.classpath
.c9/
*.launch
.settings/


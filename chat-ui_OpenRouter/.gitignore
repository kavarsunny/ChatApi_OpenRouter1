# ─────────────────────────────────────────────────────────────────
# SECRETS & SENSITIVE DATA  ← primary reason for this file
# ─────────────────────────────────────────────────────────────────

## Environment files that may contain API keys / tokens
.env
.env.*
!.env.example
!.env.sample

## Any local overrides with real credentials
environment.local.ts
src/environments/environment.local.ts

# ─────────────────────────────────────────────────────────────────
# Node / npm / yarn / pnpm
# ─────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm/
.yarn/
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
pnpm-lock.yaml
# keep package-lock.json (npm) — remove if your team uses yarn/pnpm instead

# ─────────────────────────────────────────────────────────────────
